{
  "name": "ashare-shadow-cockpit",
  "version": "7.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "check:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts --check",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.81.2",
    "echarts": "5.6.0",
    "lucide-react": "0.511.0",
    "openapi-fetch": "0.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.53.1",
    "@tailwindcss/vite": "4.1.10",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.0.3",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.8.0",
    "tailwindcss": "4.1.10",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
